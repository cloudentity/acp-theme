{{ template "base" . }}

{{ define "title" }} {{ T "identity.activate_captcha.title" }} {{ end }}

{{ define "content" }}

  {{ template "submit_button_disabling_script" . }}

  <form method="post" action="{{ .Data.Action }}" id="captcha-form">
    <input type="hidden" name="action" value="two_step_init">

    <div class="header-container">
      {{ template "header" .Config }}
    </div>

    <div class="card">
      <div class="content" id="main-content">

        {{ range .Data.FormError.Errors }}
          {{ template "error_message" . }}
        {{ end }}

        {{ if .Data.CaptchaSiteKeyV3 }}
          <h1>{{ T "identity.activate_captcha.verifying" }}</h1>
          {{ template "loader" . }}
          {{ template "recaptcha-v3-auto" . }}

          {{/*
            revealed when the invisible challenge cannot produce a token. It posts
            an empty one on purpose: the handler answers a missing token with the
            visible checkbox, which is the only challenge left that works without
            a working grecaptcha.
          */}}
          <div id="captcha-manual-submit" hidden>
            <button class="submit-button extra-top-margin" type="submit" id="submit-next">
              {{ T "identity.activate_captcha.continue" }}
            </button>
          </div>
        {{ else }}
          <h1>{{ T "identity.activate_captcha.confirm_you_are_human" }}</h1>

          <div class="recaptcha-container">
            <div class="g-recaptcha"
              data-sitekey="{{ .Data.CaptchaSiteKey }}"
              data-callback="enableSubmit"
              data-expired-callback="disableSubmit"
              data-error-callback="disableSubmit"
            ></div>
          </div>

          <button class="submit-button extra-top-margin" type="submit" id="submit-next" disabled>
            {{ T "identity.activate_captcha.continue" }}
          </button>
        {{ end }}
      </div>
    </div>
  </form>

  {{ template "footer" . }}
{{ end }}
